# --- Copy this file to .env and fill in real values ---

# Which database engine to use. "mysql" or "postgres"
DB_CLIENT=mysql

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=dayflow_hrms

# If DB_CLIENT=postgres, a typical setup looks like:
# DB_CLIENT=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=yourpassword
# DB_NAME=dayflow_hrms
