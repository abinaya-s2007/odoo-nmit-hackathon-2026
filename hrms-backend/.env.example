# ---- Server ----
PORT=8000
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Database ----
# DB_DIALECT must be either "mysql" or "postgres" — everything else
# (models, queries) is written through Sequelize so it works unchanged
# against either engine. Just flip this one value.
DB_DIALECT=mysql

# Option A: discrete connection fields (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hrms_db
DB_USER=root
DB_PASSWORD=Ashwini@1

# Option B: a single connection string overrides the fields above.
# mysql example:    mysql://user:password@localhost:3306/hrms_db
# postgres example: postgres://user:password@localhost:5432/hrms_db
# DATABASE_URL=

# Set to "true" only if your postgres provider requires SSL (e.g. hosted DBs)
DB_SSL=false
